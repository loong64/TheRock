From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TheRock contributors <therockbot@amd.com>
Date: Thu, 19 Nov 2026 00:00:00 +0000
Subject: [PATCH] rocrtst: use monotonic timer on LoongArch

---
--- a/projects/rocr-runtime/rocrtst/common/hsatimer.cc
+++ b/projects/rocr-runtime/rocrtst/common/hsatimer.cc
@@ -84,7 +84,7 @@
   }
 
 // General Linux timing method
-#ifndef _AMD
+#if !defined(_AMD) || defined(__loongarch__)
   struct timespec s;
   clock_gettime(CLOCK_MONOTONIC, &s);
   _timers[index]->_start = (uint64_t) s.tv_sec * kNanosecondsPerSecond
@@ -110,7 +110,7 @@
   }
 
   // General Linux timing method
-#ifndef _AMD
+#if !defined(_AMD) || defined(__loongarch__)
   struct timespec s;
   clock_gettime(CLOCK_MONOTONIC, &s);
   n = (uint64_t) s.tv_sec * kNanosecondsPerSecond + (uint64_t) s.tv_nsec;
@@ -124,7 +124,7 @@
   n -= _timers[index]->_start;
   _timers[index]->_start = 0;
 
-#ifndef _AMD
+#if !defined(_AMD) || defined(__loongarch__)
   _timers[index]->_clocks += n;
 #else
   // convert to ms
@@ -188,6 +188,8 @@
   uint64_t coarseIntervalNs = (coarseEndUs - coarseBeginUs) * 1000;
   uint64_t tscIntervalTicks = tscTicksEnd - tscTicksBegin;
   return (tscIntervalTicks * 10 + (coarseIntervalNs / 2)) / coarseIntervalNs;
+#elif defined(__loongarch__)
+  return 0;  // The monotonic clock does not use a TSC frequency.
 #elif defined(__powerpc64__) || defined(__PPC64__)
   // Frequency in units of 100 MHz
   return __ppc_get_timebase_freq() / 100000000;
-- 
